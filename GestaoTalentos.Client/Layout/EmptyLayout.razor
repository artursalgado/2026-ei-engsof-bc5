@inherits LayoutComponentBase

<div class="auth-page">
    <div class="auth-bg"></div>
    <main>
        @Body
    </main>
</div>

<style>
    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        position: relative;
        background: linear-gradient(145deg, #eef2ff 0%, #f0f4ff 35%, #f8fafc 70%, #f0fdf9 100%);
    }

    .auth-bg {
        position: absolute;
        inset: 0;
        background-image:
            radial-gradient(circle at 15% 15%, rgba(99, 102, 241, 0.18), transparent 38%),
            radial-gradient(circle at 85% 75%, rgba(16, 185, 129, 0.12), transparent 38%),
            radial-gradient(circle at 70% 10%, rgba(139, 92, 246, 0.08), transparent 30%);
        pointer-events: none;
    }

    .auth-page main {
        position: relative;
        width: 100%;
        max-width: 440px;
        animation: authFadeIn 0.35s ease-out;
    }

    @@keyframes authFadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
