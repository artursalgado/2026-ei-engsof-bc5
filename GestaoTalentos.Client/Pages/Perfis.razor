@page "/perfis"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Perfis de Talento</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Perfis de Talento</h2>
    <button class="btn btn-primary" @onclick="CriarNovo">+ Novo Perfil</button>
</div>

@if (carregando)
{
    <p>A carregar perfis...</p>
}
else if (erro != null)
{
    <div class="alert alert-danger">@erro</div>
}
else if (!perfis.Any())
{
    <div class="alert alert-info">Ainda não existem perfis. Cria o teu primeiro talento!</div>
}
else
{
    <div class="row g-3">
        @foreach (var p in perfis)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>@p.Nome</strong>
                        <span class="badge @(p.IsShared ? "bg-success" : "bg-secondary")">
                            @(p.IsShared ? "Público" : "Privado")
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="mb-1"><span class="text-muted">📧</span> @p.Email</p>
                        <p class="mb-1"><span class="text-muted">🌍</span> @p.Pais</p>
                        <p class="mb-1"><span class="text-muted">💶</span> @p.PrecoPorHora €/hora</p>
                        
                        @if (p.Skills != null && p.Skills.Any())
                        {
                            <div class="mt-2">
                                @foreach (var s in p.Skills)
                                {
                                    <span class="badge bg-primary me-1">@s.SkillNome (@s.AnosExperiencia ano(s))</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer d-flex justify-content-end gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Editar(p.Id)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Apagar(p.Id)">Apagar</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success mt-3">@mensagemSucesso</div>
}

@code {
    private List<PerfilVm> perfis = new();
    private bool carregando = true;
    private string? erro;
    private string? mensagemSucesso;

    protected override async Task OnInitializedAsync()
    {
        await CarregarPerfis();
    }

    private async Task CarregarPerfis()
    {
        carregando = true;
        erro = null;
        try
        {
            perfis = await Http.GetFromJsonAsync<List<PerfilVm>>("/perfis") ?? new();
        }
        catch (Exception ex)
        {
            erro = $"Erro ao carregar perfis: {ex.Message}";
        }
        carregando = false;
    }

    private void CriarNovo()
    {
        Navigation.NavigateTo("/perfis/form");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/perfis/form/{id}");
    }

    private async Task Apagar(int id)
    {
        var resposta = await Http.DeleteAsync($"/perfis/{id}");
        if (resposta.IsSuccessStatusCode)
        {
            mensagemSucesso = "Perfil apagado com sucesso.";
            await CarregarPerfis();
        }
        else
        {
            erro = "Não foi possível apagar o perfil.";
        }
    }

    // Modelo de visualização para os dados recebidos da API
    public class PerfilVm
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Pais { get; set; } = "";
        public decimal PrecoPorHora { get; set; }
        public bool IsShared { get; set; }
        public List<SkillVm> Skills { get; set; } = new();
        public List<ExperienciaVm> Experiencias { get; set; } = new();
    }

    public class SkillVm
    {
        public int SkillId { get; set; }
        public string? SkillNome { get; set; }
        public int AnosExperiencia { get; set; }
    }

    public class ExperienciaVm
    {
        public int Id { get; set; }
        public string Titulo { get; set; } = "";
        public string Empresa { get; set; } = "";
        public int AnoInicio { get; set; }
        public int? AnoFim { get; set; }
    }
}
