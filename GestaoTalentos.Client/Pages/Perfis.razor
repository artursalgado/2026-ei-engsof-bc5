@page "/perfis"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(isCliente ? "Pesquisa de Talentos" : "Perfis de Talento") - Gestão de Talentos</PageTitle>

<div class="page-header">
    <div>
        <h1>@(isCliente ? "Pesquisa de Talentos" : "Os Meus Perfis")</h1>
        <p class="page-subtitle">
            @(isCliente ? "Encontra profissionais disponíveis na plataforma" : "Gere os teus currículos e competências")
        </p>
    </div>
    <div class="page-header-actions">
        @if (!isCliente)
        {
            <button class = " btn btn-primary " @onclick = " CriarNovo "> + Novo Perfil </button>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success mb-4">@mensagemSucesso</div>
}

@* ===================== BARra DE PESQUISA SEMPRE VISÍVEL ===================== *@
<div class="skill-search-bar">
    <div class="skill-search-label">Filtrar por Skills</div>

    <div class="skill-search-row">

        <div class="skill-multiselect-wrapper">

            <div class="skill-selected-pills">
                @foreach (var sid in skillsFiltro)
                {
                    var nome = todasSkills.FirstOrDefault(s => s.Id == sid)?.Nome ?? sid.ToString();

                    <span class="skill-filter-pill">
                        @nome
                        <button class="pill-remove"
                                @onclick="() => RemoverSkillFiltro(sid)">
                            ×
                        </button>
                    </span>
                }

                <div class="skill-dropdown-trigger" @onclick="ToggleDropdown">
                    <span class="skill-add-text">
                        @(skillsFiltro.Count == 0 ? "Selecionar skills..." : "+ Adicionar")
                    </span>
                    <span class="dropdown-arrow">
                        @(dropdownAberto ? "▲" : "▼")
                    </span>
                </div>
            </div>

            @if (dropdownAberto)
            {
                <div class="skill-dropdown">
                    <input class="skill-dropdown-search"
                           placeholder="Pesquisar skill..."
                           @bind="pesquisaDropdown"
                           @bind:event="oninput" />

                    <div class="skill-dropdown-list">
                        @foreach (var sk in todasSkills.Where(s =>
                            !skillsFiltro.Contains(s.Id) &&
                            (string.IsNullOrEmpty(pesquisaDropdown)
                             || s.Nome.Contains(pesquisaDropdown, StringComparison.OrdinalIgnoreCase))))
                        {
                            <div class="skill-dropdown-item"
                                 @onclick="() => AdicionarSkillFiltro(sk.Id)">
                                @sk.Nome <span class="skill-area-tag">@sk.AreaNome</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* botão só aparece para não-clientes *@
        @if (!isCliente)
        {
            <button class="btn btn-primary"
                    @onclick="PesquisarPorSkills"
                    disabled="@(skillsFiltro.Count == 0 && !filtroAtivo)">
                @(filtroAtivo ? "Limpar Filtro" : "Pesquisar")
            </button>
        }

    </div>

    @if (filtroAtivo)
    {
        <div class="skill-filter-result-info">
            A mostrar talentos com <strong>todas</strong> as skills selecionadas.
            <span class="skill-result-count">@perfis.Count resultado(s)</span>
        </div>
    }
</div>

@* ===================== LISTA PERFIS ===================== *@
@if (carregando)
{
    <div class="loading-state">A carregar perfis...</div>
}
else if (erro != null)
{
    <div class="alert alert-danger">@erro</div>
}
else if (!perfis.Any())
{
    <div class="empty-state">
        <div class="empty-ico">👤</div>

        @if (isCliente)
        {
            <h3>Nenhum talento disponível</h3>
            <p>Ainda não há profissionais com perfil público na plataforma.</p>
        }
        else
        {
            <h3>Ainda não tens perfis</h3>
            <p>Cria o teu primeiro perfil de talento para começar.</p>
            <button class="btn btn-primary" @onclick="CriarNovo">
                Criar primeiro perfil
            </button>
        }
    </div>
}
else
{
    <div class="perfis-grid">
        @foreach (var p in perfis)
        {
            <div class="perfil-card @(isCliente ? "perfil-card-clickable" : "")"
                 @onclick="() => { if (isCliente) AbrirDetalhe(p); }">

                <div class="perfil-card-head">
                    <div class="perfil-avatar">
                        @(p.Nome.Length > 0 ? p.Nome[0].ToString().ToUpper() : "?")
                    </div>

                    <div class="perfil-info">
                        <h3>@p.Nome</h3>
                        <span class="perfil-location">📍 @p.Pais</span>
                    </div>

                    <span class="visibility-badge @(p.IsShared ? "public" : "private")">
                        @(p.IsShared ? "Público" : "Privado")
                    </span>
                </div>

                <div class="perfil-card-body">
                    <div class="perfil-meta-row">
                        <span>Email</span>
                        <span>@p.Email</span>
                    </div>

                    <div class="perfil-meta-row">
                        <span>Preço/hora</span>
                        <span>@p.PrecoPorHora €</span>
                    </div>
                </div>

                <div class="perfil-card-foot" @onclick:stopPropagation>
                    <button class="btn btn-sm btn-outline" @onclick="() => AbrirDetalhe(p)">
                        Ver Detalhe
                    </button>

                    @if (!isCliente)
                    {
                        <button class="btn btn-sm btn-secondary" @onclick="() => Editar(p.Id)">
                            Editar
                        </button>

                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarApagar(p)">
                            Apagar
                        </button>
                    }
                </div>

            </div>
        }
    </div>
}

@code {
    private List<PerfilVm> perfis = new();
    private bool carregando = true;
    private string? erro;
    private string? mensagemSucesso;

    private bool isCliente = false;
    private PerfilVm? perfilDetalhe;

    private List<SkillOpcao> todasSkills = new();
    private List<int> skillsFiltro = new();
    private bool dropdownAberto = false;
    private string pesquisaDropdown = "";
    private bool filtroAtivo = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var role = authState.User.FindFirst("role")?.Value;

        if (role == "Admin" || role == "UserManager")
        {
            isCliente = false;
        }
        else if (role == "User")
        {
            try
            {
                isCliente = await Http.GetFromJsonAsync<bool>("/clientes/me/associado");
            }
            catch
            {
                isCliente = false;
            }
        }

        await CarregarPerfis();
    }

    private async Task CarregarPerfis()
    {
        carregando = true;
        erro = null;

        try
        {
            perfis = await Http.GetFromJsonAsync<List<PerfilVm>>("/perfis") ?? new();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }

        carregando = false;
    }

    private void ToggleDropdown() => dropdownAberto = !dropdownAberto;

    private void AdicionarSkillFiltro(int id)
    {
        if (!skillsFiltro.Contains(id))
            skillsFiltro.Add(id);

        dropdownAberto = false;
        pesquisaDropdown = "";
    }

    private void RemoverSkillFiltro(int id)
    {
        skillsFiltro.Remove(id);
    }

    private async Task PesquisarPorSkills()
    {
        if (filtroAtivo)
        {
            skillsFiltro.Clear();
            filtroAtivo = false;
            await CarregarPerfis();
            return;
        }

        filtroAtivo = true;

        var query = string.Join("&", skillsFiltro.Select(x => $"skillIds={x}"));
        perfis = await Http.GetFromJsonAsync<List<PerfilVm>>($"/perfis/pesquisa-skills?{query}") ?? new();
    }

    private void AbrirDetalhe(PerfilVm p) => perfilDetalhe = p;
    private void CriarNovo() => Navigation.NavigateTo("/perfis/form");
    private void Editar(int id) => Navigation.NavigateTo($"/perfis/form/{id}");

    private async Task ConfirmarApagar(PerfilVm p)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Apagar {p.Nome}?");
        if (!ok) return;

        await Http.DeleteAsync($"/perfis/{p.Id}");
        await CarregarPerfis();
    }

    public class PerfilVm
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Pais { get; set; } = "";
        public decimal PrecoPorHora { get; set; }
        public bool IsShared { get; set; }
    }

    public class SkillOpcao
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public int AreaId { get; set; }
        public string AreaNome { get; set; } = "";
    }
}