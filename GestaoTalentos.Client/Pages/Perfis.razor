@page "/perfis"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Perfis de Talento</PageTitle>

<h1>Perfis de Talento</h1>

@* ===================== BARRA DE PESQUISA ===================== *@
<div class="skill-search-bar">

    <div class="skill-search-label">
        Filtrar por Skills
    </div>

    <div class="skill-search-row">

        <div class="skill-multiselect-wrapper">

            <div class="skill-selected-pills">

                @foreach (var sid in skillsFiltro)
                {
                    var nome = todasSkills.FirstOrDefault(s => s.Id == sid)?.Nome ?? sid.ToString();

                    <span class="skill-filter-pill">
                        @nome
                        <button @onclick="() => RemoverSkillFiltro(sid)">×</button>
                    </span>
                }

                <div class="skill-dropdown-trigger" @onclick="ToggleDropdown">
                    @(skillsFiltro.Count == 0 ? "Selecionar skills..." : "+ Adicionar")
                    <span>@(dropdownAberto ? "▲" : "▼")</span>
                </div>

            </div>

            @if (dropdownAberto)
            {
                <div class="skill-dropdown">

                    <input class="skill-dropdown-search"
                           placeholder="Pesquisar skill..."
                           @bind="pesquisaDropdown"
                           @bind:event="oninput" />

                    <div class="skill-dropdown-list">

                        @foreach (var sk in todasSkills.Where(s =>
                            !skillsFiltro.Contains(s.Id) &&
                            (string.IsNullOrWhiteSpace(pesquisaDropdown) ||
                             s.Nome.Contains(pesquisaDropdown, StringComparison.OrdinalIgnoreCase))))
                        {
                            <div class="skill-dropdown-item"
                                 @onclick="() => AdicionarSkillFiltro(sk.Id)">
                                @sk.Nome
                            </div>
                        }

                    </div>

                </div>
            }

        </div>

        <button class="btn btn-primary"
                @onclick="PesquisarPorSkills">
            @(filtroAtivo ? "Limpar filtro" : "Pesquisar")
        </button>

    </div>
</div>

@* ===================== LISTA PERFIS ===================== *@
@if (carregando)
{
    <div class="loading-state">A carregar perfis...</div>
}
else if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger">@erro</div>
}
else if (!perfis.Any())
{
    <div class="empty-state">
        <div class="empty-ico">👤</div>
        <h3>Sem perfis encontrados</h3>
        <p>Não existem perfis para os filtros aplicados.</p>
    </div>
}
else
{
    <div class="perfis-grid">

        @foreach (var p in perfis)
        {
            <div class="perfil-card">

                <div class="perfil-card-head">

                    <div class="perfil-avatar">
                        @(p.Nome.Length > 0 ? p.Nome[0].ToString().ToUpper() : "?")
                    </div>

                    <div class="perfil-info">
                        <h3>@p.Nome</h3>
                        <span class="perfil-location">📍 @p.Pais</span>
                    </div>

                </div>

                <div class="perfil-card-body">

                    <div class="perfil-meta-row">
                        <span>Email</span>
                        <span>@p.Email</span>
                    </div>

                </div>

                <div class="perfil-card-foot">

                    <button class="btn btn-sm btn-outline"
                            @onclick="() => AbrirPerfil(p.Id)">
                        Ver Detalhe
                    </button>

                </div>

            </div>
        }

    </div>
}

@code {

    private List<PerfilVm> perfis = new();
    private List<SkillOpcao> todasSkills = new();

    private List<int> skillsFiltro = new();
    private bool dropdownAberto = false;
    private string pesquisaDropdown = "";

    private bool carregando = true;
    private string? erro;
    private bool filtroAtivo = false;

    protected override async Task OnInitializedAsync()
    {
        todasSkills = new()
        {
            new() { Id = 1, Nome = "C#" },
            new() { Id = 2, Nome = "SQL" },
            new() { Id = 3, Nome = "JavaScript" },
            new() { Id = 4, Nome = "Angular" },
            new() { Id = 5, Nome = "Docker" }
        };

        await CarregarPerfis();
    }

    private async Task CarregarPerfis()
    {
        carregando = true;
        erro = null;

        try
        {
            perfis = await Http.GetFromJsonAsync<List<PerfilVm>>("/perfis") ?? new();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
            perfis = new();
        }

        carregando = false;
    }

    private void ToggleDropdown()
        => dropdownAberto = !dropdownAberto;

    private void AdicionarSkillFiltro(int id)
    {
        if (!skillsFiltro.Contains(id))
            skillsFiltro.Add(id);

        dropdownAberto = false;
        pesquisaDropdown = "";
    }

    private void RemoverSkillFiltro(int id)
        => skillsFiltro.Remove(id);

    private async Task PesquisarPorSkills()
    {
        if (filtroAtivo)
        {
            filtroAtivo = false;
            skillsFiltro.Clear();
            await CarregarPerfis();
            return;
        }

        if (skillsFiltro.Count == 0)
            return;

        filtroAtivo = true;

        var query = string.Join("&", skillsFiltro.Select(x => $"skillIds={x}"));

        perfis = await Http.GetFromJsonAsync<List<PerfilVm>>(
            $"/perfis/pesquisa-skills?{query}") ?? new();
    }

    private void AbrirPerfil(int id)
    {
        Navigation.NavigateTo($"/perfis/{id}");
    }

    private class PerfilVm
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Pais { get; set; } = "";
    }

    private class SkillOpcao
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
    }
}