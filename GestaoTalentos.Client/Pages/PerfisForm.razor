@page "/perfis/form"
@page "/perfis/form/{Id:int}"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@(Id.HasValue ? "Editar Perfil" : "Novo Perfil") - Gestão de Talentos</PageTitle>

<div class="form-page-header">
    <button class="btn-back" @onclick="Cancelar">← Perfis</button>
    <h1>@(Id.HasValue ? "Editar Perfil de Talento" : "Novo Perfil de Talento")</h1>
</div>

@if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger mb-4">@erro</div>
}

@if (carregando)
{
    <div class="loading-state">A carregar...</div>
}
else
{
    <div class="form-sections">

        <!-- Dados Pessoais -->
        <div class="form-section">
            <div class="section-header">
                <span class="section-ico"><i class="bi bi-person"></i></span>
                <h2>Dados Pessoais</h2>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nome completo *</label>
                    <input @bind="nome" class="form-control" placeholder="ex: João Silva" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email *</label>
                    <input @bind="email" class="form-control" placeholder="joao@exemplo.com" type="email" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">País *</label>
                    <input @bind="pais" class="form-control" placeholder="ex: Portugal" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Preço por hora (€) *</label>
                    <input @bind="precoPorHora" class="form-control" type="number" min="0" step="0.5" />
                </div>
                <div class="col-12">
                    <div class="toggle-row">
                        <div>
                            <div class="toggle-label">Perfil Público</div>
                            <div class="toggle-desc">Visível para todos os utilizadores da plataforma</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="isShared" />
                            <span class="toggle-track"></span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Experiências -->
        <div class="form-section">
            <div class="section-header">
                <span class="section-ico"><i class="bi bi-briefcase"></i></span>
                <h2>Experiências Profissionais</h2>
                <button type="button" class="btn btn-sm btn-secondary" @onclick="AdicionarExperiencia">+ Adicionar</button>
            </div>

            @if (!experiencias.Any())
            {
                <div class="section-empty">Nenhuma experiência adicionada ainda.</div>
            }

            @foreach (var exp in experiencias)
            {
                <div class="sub-card">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Título *</label>
                            <input @bind="exp.Titulo" class="form-control" placeholder="ex: Desenvolvedor Sénior" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Empresa *</label>
                            <input @bind="exp.Empresa" class="form-control" list="empresas-list" placeholder="ex: Google" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ano início *</label>
                            <input @bind="exp.AnoInicio" class="form-control" type="number" min="1950" max="2100" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ano fim <span class="optional">(vazio = atual)</span></label>
                            <input @bind="exp.AnoFimStr" class="form-control" type="number" min="1950" max="2100" placeholder="Em curso" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="button" class="btn btn-sm btn-danger w-100" @onclick="() => RemoverExperiencia(exp)">Remover</button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Skills -->
        <div class="form-section">
            <div class="section-header">
                <span class="section-ico"><i class="bi bi-lightning-charge-fill"></i></span>
                <h2>Skills</h2>
                <button type="button" class="btn btn-sm btn-secondary" @onclick="AdicionarSkill">+ Adicionar</button>
            </div>

            @if (!skillsAdicionadas.Any())
            {
                <div class="section-empty">Nenhuma skill adicionada ainda.</div>
            }

            @foreach (var ps in skillsAdicionadas)
            {
                <div class="sub-card">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label">Skill *</label>
                            <select @bind="ps.SkillId" class="form-select">
                                <option value="0">Seleciona uma skill</option>
                                @foreach (var s in todasAsSkills)
                                {
                                    <option value="@s.Id">@s.Nome (@s.AreaNome)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Anos exp. *</label>
                            <input @bind="ps.AnosExperiencia" class="form-control" type="number" min="1" max="50" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button" class="btn btn-sm btn-danger w-100" @onclick="() => RemoverSkill(ps)">✕</button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Ações -->
        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="Cancelar" disabled="@isBusy">Cancelar</button>
            <button class="btn btn-primary" @onclick="Guardar" disabled="@isBusy">
                @(isBusy ? "A guardar..." : (Id.HasValue ? "Guardar alterações" : "Criar perfil"))
            </button>
        </div>
    </div>
}

<datalist id="empresas-list">
    @foreach (var emp in sugestoesEmpresa)
    {
        <option value="@emp" />
    }
</datalist>

@code {
    [Parameter] public int? Id { get; set; }

    private string nome = "";
    private string email = "";
    private string pais = "";
    private decimal precoPorHora;
    private bool isShared;

    private List<ExperienciaFormVm> experiencias = new();
    private List<SkillFormVm> skillsAdicionadas = new();
    private List<SkillOpcaoVm> todasAsSkills = new();
    private List<string> sugestoesEmpresa = new();

    private bool carregando = true;
    private bool isBusy = false;
    private string? erro;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var skills = await Http.GetFromJsonAsync<List<SkillOpcaoVm>>("/skills");
            todasAsSkills = skills ?? new();

            var empresas = await Http.GetFromJsonAsync<List<string>>("/perfis/empresas-sugestoes");
            sugestoesEmpresa = empresas ?? new();
        }
        catch { }

        if (Id.HasValue)
        {
            try
            {
                var perfil = await Http.GetFromJsonAsync<PerfilDetalheVm>($"/perfis/{Id}");
                if (perfil != null)
                {
                    nome = perfil.Nome;
                    email = perfil.Email;
                    pais = perfil.Pais;
                    precoPorHora = perfil.PrecoPorHora;
                    isShared = perfil.IsShared;

                    experiencias = perfil.Experiencias.Select(e => new ExperienciaFormVm
                    {
                        Titulo = e.Titulo,
                        Empresa = e.Empresa,
                        AnoInicio = e.AnoInicio,
                        AnoFimStr = e.AnoFim?.ToString()
                    }).ToList();

                    skillsAdicionadas = perfil.Skills.Select(s => new SkillFormVm
                    {
                        SkillId = s.SkillId,
                        AnosExperiencia = s.AnosExperiencia
                    }).ToList();
                }
            }
            catch (Exception ex)
            {
                erro = $"Erro ao carregar perfil: {ex.Message}";
            }
        }

        carregando = false;
    }

    private void AdicionarExperiencia() =>
        experiencias.Add(new ExperienciaFormVm { AnoInicio = DateTime.Now.Year });

    private void RemoverExperiencia(ExperienciaFormVm exp) => experiencias.Remove(exp);
    private void AdicionarSkill() => skillsAdicionadas.Add(new SkillFormVm());
    private void RemoverSkill(SkillFormVm s) => skillsAdicionadas.Remove(s);

    private async Task Guardar()
    {
        erro = null;

        if (string.IsNullOrWhiteSpace(nome)) { erro = "Nome é obrigatório."; return; }
        if (string.IsNullOrWhiteSpace(email)) { erro = "Email é obrigatório."; return; }
        if (string.IsNullOrWhiteSpace(pais)) { erro = "País é obrigatório."; return; }
        if (precoPorHora <= 0) { erro = "Preço por hora deve ser maior que zero."; return; }

        foreach (var exp in experiencias)
        {
            if (string.IsNullOrWhiteSpace(exp.Titulo) || string.IsNullOrWhiteSpace(exp.Empresa))
            {
                erro = $"A experiência '{exp.Empresa}' tem campos obrigatórios vazios.";
                return;
            }
            int? anoFimVal = string.IsNullOrWhiteSpace(exp.AnoFimStr) ? null : int.TryParse(exp.AnoFimStr, out var v) ? v : (int?)null;
            if (anoFimVal.HasValue && anoFimVal < exp.AnoInicio)
            {
                erro = $"Em '{exp.Empresa}': o ano de fim não pode ser anterior ao início.";
                return;
            }
        }

        for (int i = 0; i < experiencias.Count; i++)
        {
            var expA = experiencias[i];
            int fimA = (string.IsNullOrWhiteSpace(expA.AnoFimStr) ? null : int.TryParse(expA.AnoFimStr, out var va) ? va : (int?)null) ?? DateTime.Now.Year;
            for (int j = i + 1; j < experiencias.Count; j++)
            {
                var expB = experiencias[j];
                int fimB = (string.IsNullOrWhiteSpace(expB.AnoFimStr) ? null : int.TryParse(expB.AnoFimStr, out var vb) ? vb : (int?)null) ?? DateTime.Now.Year;
                if (expA.AnoInicio <= fimB && expB.AnoInicio <= fimA)
                {
                    erro = $"Sobreposição detetada entre '{expA.Empresa}' e '{expB.Empresa}'.";
                    return;
                }
            }
        }

        if (skillsAdicionadas.Any(s => s.SkillId == 0))
        {
            erro = "Seleciona uma skill em todas as linhas adicionadas.";
            return;
        }
        if (skillsAdicionadas.Any(s => s.AnosExperiencia < 1))
        {
            erro = "Cada skill precisa de pelo menos 1 ano de experiência.";
            return;
        }

        isBusy = true;
        var payload = new
        {
            Nome = nome, Email = email, Pais = pais,
            PrecoPorHora = precoPorHora, IsShared = isShared,
            Experiencias = experiencias.Select(e => new
            {
                e.Titulo, e.Empresa, e.AnoInicio,
                AnoFim = string.IsNullOrWhiteSpace(e.AnoFimStr) ? (int?)null : int.Parse(e.AnoFimStr)
            }).ToList(),
            Skills = skillsAdicionadas.Select(s => new { s.SkillId, s.AnosExperiencia }).ToList()
        };

        HttpResponseMessage resposta = Id.HasValue
            ? await Http.PutAsJsonAsync($"/perfis/{Id}", payload)
            : await Http.PostAsJsonAsync("/perfis", payload);

        isBusy = false;

        if (resposta.IsSuccessStatusCode)
            Navigation.NavigateTo("/perfis");
        else
        {
            var detalhe = await resposta.Content.ReadAsStringAsync();
            erro = $"Erro ao guardar: {detalhe}";
        }
    }

    private void Cancelar() => Navigation.NavigateTo("/perfis");

    public class ExperienciaFormVm
    {
        public string Titulo { get; set; } = "";
        public string Empresa { get; set; } = "";
        public int AnoInicio { get; set; }
        public string? AnoFimStr { get; set; }
    }

    public class SkillFormVm
    {
        public int SkillId { get; set; }
        public int AnosExperiencia { get; set; }
    }

    public class SkillOpcaoVm
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public string? AreaNome { get; set; }
    }

    public class PerfilDetalheVm
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Pais { get; set; } = "";
        public decimal PrecoPorHora { get; set; }
        public bool IsShared { get; set; }
        public List<ExperienciaDetalheVm> Experiencias { get; set; } = new();
        public List<SkillDetalheVm> Skills { get; set; } = new();
    }

    public class ExperienciaDetalheVm
    {
        public int Id { get; set; }
        public string Titulo { get; set; } = "";
        public string Empresa { get; set; } = "";
        public int AnoInicio { get; set; }
        public int? AnoFim { get; set; }
    }

    public class SkillDetalheVm
    {
        public int SkillId { get; set; }
        public string? SkillNome { get; set; }
        public int AnosExperiencia { get; set; }
    }
}
