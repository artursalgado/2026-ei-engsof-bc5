@page "/propostas"
@using System.Net.Http.Json
@using GestaoTalentos.Shared.DTOs
@using GestaoTalentos.Client.Services
@using Microsoft.AspNetCore.Authorization
@inject IPropostaService PropostaService
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<h1>Propostas</h1>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="mb-3">
    <button class="btn btn-primary" @onclick="OpenCreateModal" disabled="@busy">+ Nova Proposta</button>
</div>

@if (propostas == null)
{
    <p>A carregar...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Área</th>
                <th>Horas</th>
                <th>Preço/h</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in propostas)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Nome</td>
                    <td>@p.AreaId</td>
                    <td>@p.NumeroTotalHoras</td>
                    <td>@p.PrecoHoraMedio</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-warning me-1" @onclick="() => OpenEditModal(p)" disabled="@busy">Editar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(p.Id)" disabled="@busy">Apagar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* Modal Criar *@
@if (showCreateModal)
{
    <div class="modal-backdrop fade show" style="display:block;" @onclick="CloseModals"></div>
    <div class="modal fade show" style="display:block;" tabindex="-1">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nova Proposta</h5>
                    <button type="button" class="btn-close" @onclick="CloseModals" disabled="@busy"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-danger">@formError</div>
                    }
                    <EditForm Model="createDto" OnValidSubmit="HandleCreate">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Nome</label>
                            <InputText class="form-control" @bind-Value="createDto.Nome" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Área</label>
                            <InputSelect class="form-select" @bind-Value="createDto.AreaId">
                                <option value="0">Seleciona uma área</option>
                                @foreach (var a in areas)
                                {
                                    <option value="@a.Id">@a.Nome</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descrição</label>
                            <InputTextArea class="form-control" @bind-Value="createDto.DescricaoTrabalho" rows="3" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Horas</label>
                                <InputNumber class="form-control" @bind-Value="createDto.NumeroTotalHoras" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Preço/h</label>
                                <InputNumber class="form-control" @bind-Value="createDto.PrecoHoraMedio" />
                            </div>
                        </div>

                        <hr />
                        <h5>Skills necessárias</h5>
                        @for (int i = 0; i < createDto.SkillsNecessarias.Count; i++)
                        {
                            var idx = i;
                            <div class="row align-items-end mb-2">
                                <div class="col-md-7">
                                    <label class="form-label">Skill</label>
                                    <InputSelect class="form-select" @bind-Value="createDto.SkillsNecessarias[idx].SkillId">
                                        <option value="0">Seleciona uma skill</option>
                                        @foreach (var s in skills)
                                        {
                                            <option value="@s.Id">@s.Nome</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Nível mínimo</label>
                                    <InputNumber class="form-control" @bind-Value="createDto.SkillsNecessarias[idx].AnosExperienciaMinimo" />
                                </div>
                                <div class="col-md-2 text-end">
                                    <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveCreateSkill(idx)">Remover</button>
                                </div>
                            </div>
                        }
                        <button type="button" class="btn btn-outline-secondary mb-3" @onclick="AddCreateSkill">+ Adicionar skill</button>

                        <div class="d-flex justify-content-end gap-2 mt-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModals" disabled="@busy">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@busy">@(busy ? "A criar..." : "Criar")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@* Modal Editar *@
@if (showEditModal && editDto != null)
{
    <div class="modal-backdrop fade show" style="display:block;" @onclick="CloseModals"></div>
    <div class="modal fade show" style="display:block;" tabindex="-1">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Proposta #@editId</h5>
                    <button type="button" class="btn-close" @onclick="CloseModals" disabled="@busy"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-danger">@formError</div>
                    }
                    <EditForm Model="editDto" OnValidSubmit="HandleEdit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Nome</label>
                            <InputText class="form-control" @bind-Value="editDto.Nome" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Área</label>
                            <InputSelect class="form-select" @bind-Value="editDto.AreaId">
                                <option value="0">Seleciona uma área</option>
                                @foreach (var a in areas)
                                {
                                    <option value="@a.Id">@a.Nome</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descrição</label>
                            <InputTextArea class="form-control" @bind-Value="editDto.DescricaoTrabalho" rows="3" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Horas</label>
                                <InputNumber class="form-control" @bind-Value="editDto.NumeroTotalHoras" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Preço/h</label>
                                <InputNumber class="form-control" @bind-Value="editDto.PrecoHoraMedio" />
                            </div>
                        </div>

                        <hr />
                        <h5>Skills necessárias</h5>
                        @for (int i = 0; i < editDto.SkillsNecessarias.Count; i++)
                        {
                            var idx = i;
                            <div class="row align-items-end mb-2">
                                <div class="col-md-7">
                                    <label class="form-label">Skill</label>
                                    <InputSelect class="form-select" @bind-Value="editDto.SkillsNecessarias[idx].SkillId">
                                        <option value="0">Seleciona uma skill</option>
                                        @foreach (var s in skills)
                                        {
                                            <option value="@s.Id">@s.Nome</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Nível mínimo</label>
                                    <InputNumber class="form-control" @bind-Value="editDto.SkillsNecessarias[idx].AnosExperienciaMinimo" />
                                </div>
                                <div class="col-md-2 text-end">
                                    <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveEditSkill(idx)">Remover</button>
                                </div>
                            </div>
                        }
                        <button type="button" class="btn btn-outline-secondary mb-3" @onclick="AddEditSkill">+ Adicionar skill</button>

                        <div class="d-flex justify-content-end gap-2 mt-2">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModals" disabled="@busy">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@busy">@(busy ? "A guardar..." : "Guardar")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public class PropostaReadVm
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public int AreaId { get; set; }
        public string DescricaoTrabalho { get; set; } = "";
        public int NumeroTotalHoras { get; set; }
        public decimal PrecoHoraMedio { get; set; }
        public List<SkillNecessariaDto> SkillsNecessarias { get; set; } = new();
    }

    private List<PropostaReadVm>? propostas;
    private List<AreaDto> areas = new();
    private List<SkillDto> skills = new();

    private bool showCreateModal;
    private bool showEditModal;
    private bool busy;
    private string? error;
    private string? formError;

    private CreatePropostaDto createDto = new();
    private UpdatePropostaDto? editDto;
    private int editId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        error = null;
        propostas = await Http.GetFromJsonAsync<List<PropostaReadVm>>("propostas") ?? new();
        areas = await Http.GetFromJsonAsync<List<AreaDto>>("areas") ?? new();
        skills = await Http.GetFromJsonAsync<List<SkillDto>>("skills") ?? new();
    }

    private void OpenCreateModal()
    {
        formError = null;
        createDto = new CreatePropostaDto();
        createDto.SkillsNecessarias.Add(new SkillNecessariaDto());
        showCreateModal = true;
        showEditModal = false;
    }

    private void OpenEditModal(PropostaReadVm p)
    {
        formError = null;
        editId = p.Id;
        editDto = new UpdatePropostaDto
        {
            Nome = p.Nome,
            AreaId = p.AreaId,
            DescricaoTrabalho = p.DescricaoTrabalho,
            NumeroTotalHoras = p.NumeroTotalHoras,
            PrecoHoraMedio = p.PrecoHoraMedio,
            SkillsNecessarias = p.SkillsNecessarias.Select(s => new SkillNecessariaDto
            {
                SkillId = s.SkillId,
                AnosExperienciaMinimo = s.AnosExperienciaMinimo
            }).ToList()
        };
        if (!editDto.SkillsNecessarias.Any())
            editDto.SkillsNecessarias.Add(new SkillNecessariaDto());
        showEditModal = true;
        showCreateModal = false;
    }

    private void CloseModals()
    {
        showCreateModal = false;
        showEditModal = false;
        formError = null;
    }

    private void AddCreateSkill() => createDto.SkillsNecessarias.Add(new SkillNecessariaDto());
    private void RemoveCreateSkill(int idx) => createDto.SkillsNecessarias.RemoveAt(idx);

    private void AddEditSkill() => editDto!.SkillsNecessarias.Add(new SkillNecessariaDto());
    private void RemoveEditSkill(int idx) => editDto!.SkillsNecessarias.RemoveAt(idx);

    private async Task HandleCreate()
    {
        try
        {
            busy = true;
            formError = null;

            createDto.SkillsNecessarias = createDto.SkillsNecessarias
                .Where(x => x.SkillId > 0 && x.AnosExperienciaMinimo > 0)
                .ToList();

            var resp = await PropostaService.CreateAsync(createDto);
            if (!resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                formError = $"Erro {(int)resp.StatusCode}: {body}";
                return;
            }

            CloseModals();
            await LoadAll();
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleEdit()
    {
        if (editDto == null) return;
        try
        {
            busy = true;
            formError = null;

            editDto.SkillsNecessarias = editDto.SkillsNecessarias
                .Where(x => x.SkillId > 0 && x.AnosExperienciaMinimo > 0)
                .ToList();

            var resp = await PropostaService.UpdateAsync(editId, editDto);
            if (!resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                formError = $"Erro {(int)resp.StatusCode}: {body}";
                return;
            }

            CloseModals();
            await LoadAll();
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmDelete(int id)
    {