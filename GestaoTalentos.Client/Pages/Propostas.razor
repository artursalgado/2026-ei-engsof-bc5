@page "/propostas"
@using System.Net.Http.Json
@using GestaoTalentos.Shared.DTOs
@using GestaoTalentos.Client.Services
@using Microsoft.AspNetCore.Authorization
@inject IPropostaService PropostaService
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<h1>Propostas</h1>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="mb-3">
    <button class="btn btn-primary" @onclick="OpenCreateModal" disabled="@busy">
        + Nova Proposta
    </button>
</div>

@if (propostas == null)
{
    <p>A carregar...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>Id</th>
                <th>Nome</th>
                <th>Área</th>
                <th>Horas</th>
                <th>Preço/h</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var p in propostas)
        {
            <tr>
                <td>
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="() => ToggleDetail(p.Id)">
                        @(expandedPropostaId == p.Id ? "▲" : "▼")
                    </button>
                </td>

                <td>@p.Id</td>
                <td>@p.Nome</td>
                <td>@(areas.FirstOrDefault(a => a.Id == p.AreaId)?.Nome ?? "-")</td>
                <td>@p.NumeroTotalHoras</td>
                <td>@p.PrecoHoraMedio</td>

                <td class="text-end">
                    <button class="btn btn-sm btn-warning me-1"
                            @onclick="() => OpenEditModal(p)"
                            disabled="@busy">
                        Editar
                    </button>

                    <button class="btn btn-sm btn-danger"
                            @onclick="() => ConfirmDelete(p.Id)"
                            disabled="@busy">
                        Apagar
                    </button>
                </td>
            </tr>

            @if (expandedPropostaId == p.Id)
            {
                <tr class="table-light">
                    <td colspan="7">

                        <div class="mt-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => ToggleDropdown(p.Id)">
                                Selecionar Talento
                            </button>

                            @if (dropdownPropostaId == p.Id)
                            {
                                <div class="border rounded p-2 mt-2 bg-white">

                                    @if (p.TalentosElegiveis == null || !p.TalentosElegiveis.Any())
                                    {
                                        <span class="text-muted">Nenhum talento elegível</span>
                                    }
                                    else
                                    {
                                        @foreach (var t in p.TalentosElegiveis.OrderBy(x => x.ValorEstimado))
                                        {
                                            <div class="d-flex justify-content-between align-items-center p-2 border-bottom">

                                                <div>
                                                    <strong>
                                                        @(t.Perfil?.Nome ?? $"Perfil #{t.PerfilId}")
                                                    </strong>

                                                    <div class="text-muted small">
                                                        @t.Perfil?.Pais | @t.Perfil?.PrecoPorHora € /h
                                                    </div>

                                                    @if (perfilSelecionadoId == t.PerfilId)
                                                    {
                                                        <span class="badge bg-success mt-1">
                                                            Selecionado
                                                        </span>
                                                    }
                                                </div>

                                                <button class="btn btn-sm btn-success"
                                                        @onclick="() => SelecionarPerfil(t.PerfilId)">
                                                    Selecionar
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>

                        <hr />

                        <strong>Resumo dos talentos elegíveis</strong>

                        @if (p.TalentosElegiveis == null || !p.TalentosElegiveis.Any())
                        {
                            <span class="text-muted ms-2">Nenhum talento elegível encontrado.</span>
                        }
                        else
                        {
                            <table class="table table-sm mt-2 mb-0">
                                <thead>
                                    <tr>
                                        <th>Talento</th>
                                        <th>País</th>
                                        <th>Preço/h (€)</th>
                                        <th>Valor Estimado (€)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var t in p.TalentosElegiveis.OrderBy(x => x.ValorEstimado))
                                {
                                    <tr>
                                        <td>@(t.Perfil?.Nome ?? $"Perfil #{t.PerfilId}")</td>
                                        <td>@(t.Perfil?.Pais ?? "-")</td>
                                        <td>@(t.Perfil?.PrecoPorHora.ToString("F2") ?? "-")</td>
                                        <td>@t.ValorEstimado.ToString("F2")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }

                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
}

@code {

    public class TalentoElegivelVm
    {
        public int Id { get; set; }
        public int PerfilId { get; set; }
        public decimal ValorEstimado { get; set; }
        public PerfilResumoVm? Perfil { get; set; }
    }

    public class PerfilResumoVm
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public string Pais { get; set; } = "";
        public decimal PrecoPorHora { get; set; }
    }

    public class PropostaReadVm
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public int AreaId { get; set; }
        public string DescricaoTrabalho { get; set; } = "";
        public int NumeroTotalHoras { get; set; }
        public decimal PrecoHoraMedio { get; set; }
        public List<SkillNecessariaDto> SkillsNecessarias { get; set; } = new();
        public List<TalentoElegivelVm> TalentosElegiveis { get; set; } = new();
    }

    private List<PropostaReadVm>? propostas;
    private List<AreaDto> areas = new();
    private List<SkillDto> skills = new();

    private int? expandedPropostaId;
    private int? dropdownPropostaId;
    private int? perfilSelecionadoId;

    private bool showCreateModal;
    private bool showEditModal;
    private bool busy;

    private string? error;
    private string? formError;

    private CreatePropostaDto createDto = new();
    private UpdatePropostaDto? editDto;
    private int editId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        error = null;

        propostas = await Http.GetFromJsonAsync<List<PropostaReadVm>>("propostas") ?? new();
        areas = await Http.GetFromJsonAsync<List<AreaDto>>("areas") ?? new();
        skills = await Http.GetFromJsonAsync<List<SkillDto>>("skills") ?? new();
    }

    private void ToggleDropdown(int propostaId)
    {
        dropdownPropostaId =
            dropdownPropostaId == propostaId ? null : propostaId;
    }

    private async Task ToggleDetail(int propostaId)
    {
        if (expandedPropostaId == propostaId)
        {
            expandedPropostaId = null;
            dropdownPropostaId = null;
            return;
        }

        expandedPropostaId = propostaId;
        dropdownPropostaId = null;

        var p = propostas?.FirstOrDefault(x => x.Id == propostaId);

        if (p == null)
            return;

        if (p.TalentosElegiveis == null || !p.TalentosElegiveis.Any())
        {
            try
            {
                var detail = await Http.GetFromJsonAsync<PropostaReadVm>($"propostas/{propostaId}");

                if (detail?.TalentosElegiveis != null)
                    p.TalentosElegiveis = detail.TalentosElegiveis;
            }
            catch
            {
                p.TalentosElegiveis = new();
            }
        }
    }

    private void SelecionarPerfil(int perfilId)
    {
        perfilSelecionadoId = perfilId;
    }

    private void OpenCreateModal()
    {
        formError = null;
        createDto = new CreatePropostaDto();
        createDto.SkillsNecessarias.Add(new SkillNecessariaDto());
        showCreateModal = true;
        showEditModal = false;
    }

    private void OpenEditModal(PropostaReadVm p)
    {
        formError = null;
        editId = p.Id;

        editDto = new UpdatePropostaDto
        {
            Nome = p.Nome,
            AreaId = p.AreaId,
            DescricaoTrabalho = p.DescricaoTrabalho,
            NumeroTotalHoras = p.NumeroTotalHoras,
            PrecoHoraMedio = p.PrecoHoraMedio,
            SkillsNecessarias = p.SkillsNecessarias
                .Select(s => new SkillNecessariaDto
                {
                    SkillId = s.SkillId,
                    AnosExperienciaMinimo = s.AnosExperienciaMinimo
                }).ToList()
        };

        showEditModal = true;
        showCreateModal = false;
    }

    private void CloseModals()
    {
        showCreateModal = false;
        showEditModal = false;
        formError = null;
    }

    private async Task ConfirmDelete(int id)
    {
        try
        {
            busy = true;

            var resp = await PropostaService.DeleteAsync(id);

            if (!resp.IsSuccessStatusCode)
                error = await resp.Content.ReadAsStringAsync();

            await LoadAll();
        }
        finally
        {
            busy = false;
        }
    }
}