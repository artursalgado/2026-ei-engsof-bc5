@page "/propostas"
@using System.Net.Http.Json
@using GestaoTalentos.Shared.DTOs
@using GestaoTalentos.Client.Services
@using Microsoft.AspNetCore.Authorization
@inject IPropostaService PropostaService
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Propostas - Gestão de Talentos</PageTitle>

<div class="page-header">
    <div>
        <h1>Propostas de Trabalho</h1>
        <p class="page-subtitle">Gere as propostas e consulta talentos elegíveis</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateModal" disabled="@busy">
        + Nova Proposta
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (propostas == null)
{
    <div class="loading-state">A carregar propostas...</div>
}
else if (!propostas.Any())
{
    <div class="empty-state">
        <div class="empty-ico"><i class="bi bi-file-text"></i></div>
        <h3>Ainda não há propostas</h3>
        <p>Cria a primeira proposta de trabalho para começar.</p>
        <button class="btn btn-primary" @onclick="OpenCreateModal">Criar primeira proposta</button>
    </div>
}
else
{
    <div class="card table-card">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th style="width:36px;"></th>
                    <th>Nome</th>
                    <th>Área</th>
                    <th class="text-end">Horas</th>
                    <th class="text-end">Preço/h</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in propostas)
                {
                    <tr>
                        <td>
                            <button class="btn-expand" @onclick="() => ToggleDetail(p.Id)" title="Ver talentos elegíveis">
                                @(expandedPropostaId == p.Id ? "▲" : "▼")
                            </button>
                        </td>
                        <td class="cell-name">@p.Nome</td>
                        <td><span class="badge badge-area">@(areas.FirstOrDefault(a => a.Id == p.AreaId)?.Nome ?? "-")</span></td>
                        <td class="text-end cell-muted">@p.NumeroTotalHoras h</td>
                        <td class="text-end cell-muted">@p.PrecoHoraMedio.ToString("F2") €</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-secondary" @onclick="() => OpenEditModal(p)" disabled="@busy">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(p.Id)" disabled="@busy">Apagar</button>
                        </td>
                    </tr>
                    @if (expandedPropostaId == p.Id)
                    {
                        <tr>
                            <td colspan="6" class="expanded-row">
                                <div class="elegivel-section">
                                    <h4 class="elegivel-title">Talentos Elegíveis</h4>
                                    @if (!p.TalentosElegiveis.Any())
                                    {
                                        <p class="elegivel-empty">Nenhum talento elegível encontrado para esta proposta.</p>
                                    }
                                    else
                                    {
                                        <div class="elegivel-grid">
                                            @foreach (var t in p.TalentosElegiveis.OrderBy(x => x.ValorEstimado))
                                            {
                                                <div class="elegivel-card">
                                                    <div class="elegivel-avatar">@(t.Perfil?.Nome?.Length > 0 ? t.Perfil.Nome[0].ToString().ToUpper() : "?")</div>
                                                    <div class="elegivel-info">
                                                        <div class="elegivel-nome">@(t.Perfil?.Nome ?? $"Perfil #{t.PerfilId}")</div>
                                                        <div class="elegivel-pais">@(t.Perfil?.Pais ?? "-")</div>
                                                    </div>
                                                    <div class="elegivel-valores">
                                                        <span class="elegivel-preco">@(t.Perfil?.PrecoPorHora.ToString("F2") ?? "-") €/h</span>
                                                        <span class="elegivel-total">@t.ValorEstimado.ToString("F2") € total</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@* Modal Criar *@
@if (showCreateModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseModals"></div>
    <div class="modal-custom modal-wide" @onclick:stopPropagation>
        <div class="modal-head">
            <h3>Nova Proposta</h3>
            <button class="modal-close" @onclick="CloseModals" disabled="@busy">×</button>
        </div>
        <div class="modal-body-custom">
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <div class="alert alert-danger">@formError</div>
            }
            <EditForm Model="createDto" OnValidSubmit="HandleCreate">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Nome</label>
                        <InputText class="form-control" @bind-Value="createDto.Nome" placeholder="Nome da proposta" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Área</label>
                        <InputSelect class="form-select" @bind-Value="createDto.AreaId">
                            <option value="0">Seleciona uma área</option>
                            @foreach (var a in areas)
                            {
                                <option value="@a.Id">@a.Nome</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Descrição</label>
                    <InputTextArea class="form-control" @bind-Value="createDto.DescricaoTrabalho" rows="3" placeholder="Descreve o trabalho pretendido" />
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Total de Horas</label>
                        <InputNumber class="form-control" @bind-Value="createDto.NumeroTotalHoras" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Preço por hora (€)</label>
                        <InputNumber class="form-control" @bind-Value="createDto.PrecoHoraMedio" />
                    </div>
                </div>

                <div class="skills-section">
                    <div class="skills-section-head">
                        <h4>Skills necessárias</h4>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="AddCreateSkill">+ Adicionar</button>
                    </div>
                    @for (int i = 0; i < createDto.SkillsNecessarias.Count; i++)
                    {
                        var idx = i;
                        <div class="skill-row">
                            <div class="skill-row-select">
                                <InputSelect class="form-select" @bind-Value="createDto.SkillsNecessarias[idx].SkillId">
                                    <option value="0">Seleciona uma skill</option>
                                    @foreach (var s in skills)
                                    {
                                        <option value="@s.Id">@s.Nome</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="skill-row-anos">
                                <InputNumber class="form-control" @bind-Value="createDto.SkillsNecessarias[idx].AnosExperienciaMinimo" placeholder="Anos" />
                            </div>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveCreateSkill(idx)">✕</button>
                        </div>
                    }
                </div>

                <div class="modal-foot">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModals" disabled="@busy">Cancelar</button>
                    <button type="submit" class="btn btn-primary" disabled="@busy">@(busy ? "A criar..." : "Criar Proposta")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* Modal Editar *@
@if (showEditModal && editDto != null)
{
    <div class="modal-backdrop-custom" @onclick="CloseModals"></div>
    <div class="modal-custom modal-wide" @onclick:stopPropagation>
        <div class="modal-head">
            <h3>Editar Proposta #@editId</h3>
            <button class="modal-close" @onclick="CloseModals" disabled="@busy">×</button>
        </div>
        <div class="modal-body-custom">
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <div class="alert alert-danger">@formError</div>
            }
            <EditForm Model="editDto" OnValidSubmit="HandleEdit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Nome</label>
                        <InputText class="form-control" @bind-Value="editDto.Nome" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Área</label>
                        <InputSelect class="form-select" @bind-Value="editDto.AreaId">
                            <option value="0">Seleciona uma área</option>
                            @foreach (var a in areas)
                            {
                                <option value="@a.Id">@a.Nome</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Descrição</label>
                    <InputTextArea class="form-control" @bind-Value="editDto.DescricaoTrabalho" rows="3" />
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Total de Horas</label>
                        <InputNumber class="form-control" @bind-Value="editDto.NumeroTotalHoras" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Preço por hora (€)</label>
                        <InputNumber class="form-control" @bind-Value="editDto.PrecoHoraMedio" />
                    </div>
                </div>

                <div class="skills-section">
                    <div class="skills-section-head">
                        <h4>Skills necessárias</h4>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="AddEditSkill">+ Adicionar</button>
                    </div>
                    @for (int i = 0; i < editDto.SkillsNecessarias.Count; i++)
                    {
                        var idx = i;
                        <div class="skill-row">
                            <div class="skill-row-select">
                                <InputSelect class="form-select" @bind-Value="editDto.SkillsNecessarias[idx].SkillId">
                                    <option value="0">Seleciona uma skill</option>
                                    @foreach (var s in skills)
                                    {
                                        <option value="@s.Id">@s.Nome</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="skill-row-anos">
                                <InputNumber class="form-control" @bind-Value="editDto.SkillsNecessarias[idx].AnosExperienciaMinimo" placeholder="Anos" />
                            </div>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveEditSkill(idx)">✕</button>
                        </div>
                    }
                </div>

                <div class="modal-foot">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModals" disabled="@busy">Cancelar</button>
                    <button type="submit" class="btn btn-primary" disabled="@busy">@(busy ? "A guardar..." : "Guardar")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (toastVisible)
{
    <div class="toast-sucesso">@toastMensagem</div>
}

@code {
    public class TalentoElegivelVm
    {
        public int Id { get; set; }
        public int PerfilId { get; set; }
        public decimal ValorEstimado { get; set; }
        public PerfilResumoVm? Perfil { get; set; }
    }

    public class PerfilResumoVm
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public string Pais { get; set; } = "";
        public decimal PrecoPorHora { get; set; }
    }

    public class PropostaReadVm
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public int AreaId { get; set; }
        public string DescricaoTrabalho { get; set; } = "";
        public int NumeroTotalHoras { get; set; }
        public decimal PrecoHoraMedio { get; set; }
        public List<SkillNecessariaDto> SkillsNecessarias { get; set; } = new();
        public List<TalentoElegivelVm> TalentosElegiveis { get; set; } = new();
    }

    private List<PropostaReadVm>? propostas;
    private List<AreaDto> areas = new();
    private List<SkillDto> skills = new();
    private int? expandedPropostaId;

    private bool showCreateModal;
    private bool showEditModal;
    private bool busy;
    private string? error;
    private string? formError;
    private bool toastVisible = false;
    private string toastMensagem = "";

    private CreatePropostaDto createDto = new();
    private UpdatePropostaDto? editDto;
    private int editId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        error = null;
        propostas = await Http.GetFromJsonAsync<List<PropostaReadVm>>("propostas") ?? new();
        areas = await Http.GetFromJsonAsync<List<AreaDto>>("areas") ?? new();
        skills = await Http.GetFromJsonAsync<List<SkillDto>>("skills") ?? new();
    }

    private void OpenCreateModal()
    {
        formError = null;
        createDto = new CreatePropostaDto();
        createDto.SkillsNecessarias.Add(new SkillNecessariaDto());
        showCreateModal = true;
        showEditModal = false;
    }

    private void OpenEditModal(PropostaReadVm p)
    {
        formError = null;
        editId = p.Id;
        editDto = new UpdatePropostaDto
        {
            Nome = p.Nome,
            AreaId = p.AreaId,
            DescricaoTrabalho = p.DescricaoTrabalho,
            NumeroTotalHoras = p.NumeroTotalHoras,
            PrecoHoraMedio = p.PrecoHoraMedio,
            SkillsNecessarias = p.SkillsNecessarias.Select(s => new SkillNecessariaDto
            {
                SkillId = s.SkillId,
                AnosExperienciaMinimo = s.AnosExperienciaMinimo
            }).ToList()
        };
        if (!editDto.SkillsNecessarias.Any())
            editDto.SkillsNecessarias.Add(new SkillNecessariaDto());
        showEditModal = true;
        showCreateModal = false;
    }

    private void CloseModals()
    {
        showCreateModal = false;
        showEditModal = false;
        formError = null;
    }

    private async Task ToggleDetail(int propostaId)
    {
        if (expandedPropostaId == propostaId)
        {
            expandedPropostaId = null;
            return;
        }
        expandedPropostaId = propostaId;
        var p = propostas?.FirstOrDefault(x => x.Id == propostaId);
        if (p != null && !p.TalentosElegiveis.Any())
        {
            try
            {
                var detail = await Http.GetFromJsonAsync<PropostaReadVm>($"propostas/{propostaId}");
                if (detail != null)
                    p.TalentosElegiveis = detail.TalentosElegiveis;
            }
            catch { }
        }
    }

    private void AddCreateSkill() => createDto.SkillsNecessarias.Add(new SkillNecessariaDto());
    private void RemoveCreateSkill(int idx) => createDto.SkillsNecessarias.RemoveAt(idx);

    private void AddEditSkill() => editDto!.SkillsNecessarias.Add(new SkillNecessariaDto());
    private void RemoveEditSkill(int idx) => editDto!.SkillsNecessarias.RemoveAt(idx);

    private async Task HandleCreate()
    {
        try
        {
            busy = true;
            formError = null;

            createDto.SkillsNecessarias = createDto.SkillsNecessarias
                .Where(x => x.SkillId > 0 && x.AnosExperienciaMinimo > 0)
                .ToList();

            var resp = await PropostaService.CreateAsync(createDto);
            if (!resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                formError = $"Erro {(int)resp.StatusCode}: {body}";
                return;
            }

            CloseModals();
            await LoadAll();
            await ShowToast("Proposta criada com sucesso.");
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleEdit()
    {
        if (editDto == null) return;
        try
        {
            busy = true;
            formError = null;

            editDto.SkillsNecessarias = editDto.SkillsNecessarias
                .Where(x => x.SkillId > 0 && x.AnosExperienciaMinimo > 0)
                .ToList();

            var resp = await PropostaService.UpdateAsync(editId, editDto);
            if (!resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                formError = $"Erro {(int)resp.StatusCode}: {body}";
                return;
            }

            CloseModals();
            await LoadAll();
            await ShowToast("Proposta atualizada com sucesso.");
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmDelete(int id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Queres mesmo apagar esta proposta?");
        if (!ok) return;
        try
        {
            busy = true;
            var resp = await PropostaService.DeleteAsync(id);
            if (!resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                error = $"Erro {(int)resp.StatusCode}: {body}";
                return;
            }
            await LoadAll();
            await ShowToast("Proposta apagada.");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ShowToast(string msg)
    {
        toastMensagem = msg;
        toastVisible = true;
        StateHasChanged();
        await Task.Delay(3000);
        toastVisible = false;
        StateHasChanged();
    }
}
