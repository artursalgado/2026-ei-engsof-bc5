@page "/skills"
@using GestaoTalentos.Shared.DTOs
@using GestaoTalentos.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject ISkillService SkillService
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Skills - Gestão de Talentos</PageTitle>

<div class="page-header">
    <div>
        <h1>Catálogo de Skills</h1>
        <p class="page-subtitle">@(podeGerir ? "Gere as competências disponíveis na plataforma" : "Competências disponíveis na plataforma")</p>
    </div>
    @if (podeGerir)
    {
        <button class="btn btn-primary" @onclick="OpenCreateModal" disabled="@isBusy">
            <i class="bi bi-plus-lg"></i> Nova Skill
        </button>
    }
</div>

@if (skills == null)
{
    <div class="loading-state"><i class="bi bi-hourglass-split"></i> A carregar...</div>
}
else if (skills.Count == 0)
{
    <div class="empty-state">
        <div class="empty-ico"><i class="bi bi-lightning-charge"></i></div>
        <h3>Ainda não há skills</h3>
        @if (podeGerir)
        {
            <p>Começa por adicionar a primeira competência ao catálogo.</p>
            <button class="btn btn-primary" @onclick="OpenCreateModal">Criar primeira skill</button>
        }
        else
        {
            <p>Ainda não foram adicionadas competências ao catálogo.</p>
        }
    </div>
}
else
{
    <div class="search-bar">
        <i class="bi bi-search search-icon"></i>
        <input class="search-input" type="text" placeholder="Pesquisar skill ou área..." @bind="searchQuery" @bind:event="oninput" />
        @if (!string.IsNullOrEmpty(searchQuery))
        {
            <button class="search-clear" @onclick="() => searchQuery = string.Empty" title="Limpar">
                <i class="bi bi-x"></i>
            </button>
        }
    </div>

    @if (FilteredSkillGroups.Count == 0)
    {
        <div class="no-results">
            <i class="bi bi-search"></i>
            <span>Nenhuma skill encontrada para "<strong>@searchQuery</strong>"</span>
        </div>
    }
    else
    {
        <div class="counter-row">
            <span class="counter-badge">@FilteredSkillsCount skill@(FilteredSkillsCount != 1 ? "s" : "")</span>
            <span class="counter-badge">@FilteredSkillGroups.Count área@(FilteredSkillGroups.Count != 1 ? "s" : "")</span>
        </div>

        <div class="skills-areas">
            @foreach (var (group, idx) in FilteredSkillGroups.Select((group, index) => (group, index)))
            {
                var accentClass = $"accent-{idx % 6}";
                var iconClass = GetAreaIcon(idx);

                <section class="skill-area-section @accentClass">
                    <div class="area-header">
                        <div class="area-heading">
                            <div class="area-icon">
                                <i class="bi @iconClass"></i>
                            </div>
                            <div>
                                <h2>@group.AreaNome</h2>
                            </div>
                        </div>
                        <span class="area-counter">@SkillCountLabel(group.Skills.Count)</span>
                    </div>

                    <div class="skill-pill-list">
                        @foreach (var skill in group.Skills)
                        {
                            <div class="skill-pill">
                                <span class="skill-name">@skill.Nome</span>
                                @if (podeGerir)
                                {
                                    <span class="pill-actions">
                                        <button type="button" class="pill-action pill-edit" @onclick="() => OpenEditModal(skill)" disabled="@isBusy" title="Editar @skill.Nome">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="pill-action pill-delete" @onclick="() => ConfirmDelete(skill)" disabled="@isBusy" title="Apagar @skill.Nome">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    }
}

@if (showModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseModal"></div>
    <div class="modal-custom" @onclick:stopPropagation>
        <div class="modal-head">
            <h3>@(isEditMode ? "Editar Skill" : "Nova Skill")</h3>
            <button class="modal-close" @onclick="CloseModal" disabled="@isBusy">&times;</button>
        </div>

        <div class="modal-body-custom">
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <div class="alert alert-danger">@formError</div>
            }

            @if (isEditMode)
            {
                <EditForm Model="@updateSkill" OnValidSubmit="@HandleUpdateSubmit">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Nome da Skill</label>
                        <InputText class="form-control" @bind-Value="updateSkill.Nome" placeholder="ex: React, C#, SQL" />
                        <ValidationMessage For="@(() => updateSkill.Nome)" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Área Profissional</label>
                        <InputSelect class="form-select" @bind-Value="updateSkill.AreaId">
                            <option value="0">Seleciona uma área</option>
                            @if (areas != null)
                            {
                                foreach (var area in areas)
                                {
                                    <option value="@area.Id">@area.Nome</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => updateSkill.AreaId)" />
                    </div>
                    <div class="modal-foot">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal" disabled="@isBusy">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@isBusy">@(isBusy ? "A guardar..." : "Guardar")</button>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="@createSkill" OnValidSubmit="@HandleCreateSubmit">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Nome da Skill</label>
                        <InputText class="form-control" @bind-Value="createSkill.Nome" placeholder="ex: React, C#, SQL" />
                        <ValidationMessage For="@(() => createSkill.Nome)" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Área Profissional</label>
                        <InputSelect class="form-select" @bind-Value="createSkill.AreaId">
                            <option value="0">Seleciona uma área</option>
                            @if (areas != null)
                            {
                                foreach (var area in areas)
                                {
                                    <option value="@area.Id">@area.Nome</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => createSkill.AreaId)" />
                    </div>
                    <div class="modal-foot">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal" disabled="@isBusy">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@isBusy">@(isBusy ? "A criar..." : "Criar Skill")</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@if (toastVisible)
{
    <div class="toast-sucesso">@toastMensagem</div>
}

@code {
    private List<SkillDto>? skills;
    private List<AreaDto>? areas;
    private CreateSkillDto createSkill = new();
    private UpdateSkillDto updateSkill = new();
    private string searchQuery = "";

    private bool showModal = false;
    private bool isEditMode = false;
    private int editingSkillId = 0;

    private bool isBusy = false;
    private string? formError = null;
    private bool toastVisible = false;
    private string toastMensagem = "";
    private bool podeGerir = false;
    private static readonly string[] AreaIcons =
    {
        "bi-code-slash",
        "bi-briefcase",
        "bi-diagram-3",
        "bi-graph-up-arrow",
        "bi-palette",
        "bi-cpu"
    };

    private List<SkillAreaGroup> FilteredSkillGroups => (skills ?? new List<SkillDto>())
        .Where(MatchesSearch)
        .GroupBy(skill => new
        {
            skill.AreaId,
            AreaNome = string.IsNullOrWhiteSpace(skill.AreaNome) ? "Sem área" : skill.AreaNome
        })
        .OrderBy(group => group.Key.AreaNome)
        .Select(group => new SkillAreaGroup(
            group.Key.AreaId,
            group.Key.AreaNome,
            group.OrderBy(skill => skill.Nome).ToList()))
        .ToList();

    private int FilteredSkillsCount => FilteredSkillGroups.Sum(group => group.Skills.Count);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var role = authState.User.FindFirst("role")?.Value;
        podeGerir = role == "UserManager" || role == "Admin";

        await LoadSkills();
        try {
            areas = await Http.GetFromJsonAsync<List<AreaDto>>("/areas");
        } catch (Exception ex) {
            formError = $"Aviso: não foi possível carregar as áreas: {ex.Message}";
        }
    }

    private async Task LoadSkills()
    {
        skills = await SkillService.GetAllSkillsAsync();
    }

    private bool MatchesSearch(SkillDto skill)
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            return true;
        }

        return skill.Nome.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(skill.AreaNome)
                && skill.AreaNome.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
    }

    private static string GetAreaIcon(int index) => AreaIcons[index % AreaIcons.Length];

    private static string SkillCountLabel(int count) => $"{count} skill{(count == 1 ? "" : "s")}";

    private void OpenCreateModal()
    {
        formError = null;
        isEditMode = false;
        createSkill = new CreateSkillDto();
        showModal = true;
    }

    private Task OpenEditModal(SkillDto skill)
    {
        formError = null;
        isEditMode = true;
        editingSkillId = skill.Id;

        updateSkill = new UpdateSkillDto
        {
            Nome = skill.Nome,
            AreaId = skill.AreaId
        };

        showModal = true;
        return Task.CompletedTask;
    }

    private async Task HandleCreateSubmit()
    {
        try
        {
            isBusy = true;
            formError = null;

            var result = await SkillService.CreateSkillAsync(createSkill);
            if (result != null)
            {
                await LoadSkills();
                CloseModal();
                await ShowToast("Skill criada com sucesso.");
            }
            else
            {
                formError = "Não foi possível criar a skill.";
            }
        }
        catch (Exception ex)
        {
            formError = $"Erro ao criar skill: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleUpdateSubmit()
    {
        try
        {
            isBusy = true;
            formError = null;

            var success = await SkillService.UpdateSkillAsync(editingSkillId, updateSkill);
            if (success)
            {
                await LoadSkills();
                CloseModal();
                await ShowToast("Skill atualizada com sucesso.");
            }
            else
            {
                formError = "Não foi possível atualizar a skill (verifica se tens permissões).";
            }
        }
        catch (Exception ex)
        {
            formError = $"Erro ao atualizar skill: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ConfirmDelete(SkillDto skill)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Queres mesmo apagar a skill '{skill.Nome}'?");
        if (confirmed)
        {
            await DeleteSkill(skill.Id);
        }
    }

    private async Task DeleteSkill(int id)
    {
        try
        {
            isBusy = true;
            var success = await SkillService.DeleteSkillAsync(id);
            if (success)
            {
                await LoadSkills();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Erro ao apagar. Verifica se a Skill não está a ser usada num perfil.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ShowToast(string mensagem)
    {
        toastMensagem = mensagem;
        toastVisible = true;
        StateHasChanged();
        await Task.Delay(3000);
        toastVisible = false;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        formError = null;
        createSkill = new CreateSkillDto();
        updateSkill = new UpdateSkillDto();
        editingSkillId = 0;
        isEditMode = false;
    }

    private sealed class SkillAreaGroup
    {
        public SkillAreaGroup(int areaId, string areaNome, List<SkillDto> skills)
        {
            AreaId = areaId;
            AreaNome = areaNome;
            Skills = skills;
        }

        public int AreaId { get; }
        public string AreaNome { get; }
        public List<SkillDto> Skills { get; }
    }
}
