@page "/skills"
@using GestaoTalentos.Shared.DTOs
@using GestaoTalentos.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject ISkillService SkillService
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1><i class="oi oi-star"></i> Gerenciar Skills</h1>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-success btn-lg" @onclick="OpenCreateModal" disabled="@isBusy">
                <i class="oi oi-plus"></i> Criar Skill
            </button>
        </div>
    </div>

    @if (skills == null)
    {
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
    }
    else if (skills.Count == 0)
    {
        <div class="alert alert-info">
            <i class="oi oi-info"></i> Nenhuma skill cadastrada. Clique em "Criar Skill" para adicionar uma nova.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Área</th>
                        <th>Criado em</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var skill in skills)
                    {
                        <tr>
                            <td>
                                <i class="oi oi-check"></i> @skill.Nome
                            </td>
                            <td>
                                <span class="badge bg-primary">@skill.AreaNome</span>
                            </td>
                            <td>
                                @skill.CriadoEm.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary"
                                        @onclick="() => OpenEditModal(skill)"
                                        disabled="@isBusy"
                                        title="Editar">
                                    <i class="oi oi-pencil"></i> Editar
                                </button>
                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => ConfirmDelete(skill)"
                                        disabled="@isBusy"
                                        title="Apagar">
                                    <i class="oi oi-trash"></i> Apagar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal -->
<div class="modal @(showModal ? "show d-block" : "")" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="oi oi-@(isEditMode ? "pencil" : "plus")"></i>
                    @(isEditMode ? "Editar Skill" : "Criar Nova Skill")
                </h5>
                <button type="button" class="btn-close" @onclick="CloseModal" disabled="@isBusy"></button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(formError))
                {
                    <div class="alert alert-danger">@formError</div>
                }

                @if (isEditMode)
                {
                    <EditForm Model="@updateSkill" OnValidSubmit="@HandleUpdateSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="nome" class="form-label">Nome da Skill *</label>
                            <InputText id="nome" class="form-control" @bind-Value="updateSkill.Nome" />
                            <ValidationMessage For="@(() => updateSkill.Nome)" />
                        </div>

                        <div class="mb-3">
                            <label for="areaId" class="form-label">Área Profissional *</label>
                            <InputSelect id="areaId" class="form-select" @bind-Value="updateSkill.AreaId">
                                <option value="0">Selecione uma Área</option>
                                @if (areas != null)
                                {
                                    foreach (var area in areas)
                                    {
                                        <option value="@area.Id">@area.Nome</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => updateSkill.AreaId)" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal" disabled="@isBusy">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@isBusy">
                                <i class="oi oi-pencil"></i> @(isBusy ? "A atualizar..." : "Atualizar")
                            </button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <EditForm Model="@createSkill" OnValidSubmit="@HandleCreateSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="nome" class="form-label">Nome da Skill *</label>
                            <InputText id="nome" class="form-control" @bind-Value="createSkill.Nome" />
                            <ValidationMessage For="@(() => createSkill.Nome)" />
                        </div>

                        <div class="mb-3">
                            <label for="areaId" class="form-label">Área Profissional *</label>
                            <InputSelect id="areaId" class="form-select" @bind-Value="createSkill.AreaId">
                                <option value="0">Selecione uma Área</option>
                                @if (areas != null)
                                {
                                    foreach (var area in areas)
                                    {
                                        <option value="@area.Id">@area.Nome</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => createSkill.AreaId)" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal" disabled="@isBusy">Cancelar</button>
                            <button type="submit" class="btn btn-success" disabled="@isBusy">
                                <i class="oi oi-plus"></i> @(isBusy ? "A criar..." : "Criar")
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<SkillDto>? skills;
    private List<AreaDto>? areas;
    private CreateSkillDto createSkill = new();
    private UpdateSkillDto updateSkill = new();

    private bool showModal = false;
    private bool isEditMode = false;
    private int editingSkillId = 0;

    private bool isBusy = false;
    private string? formError = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadSkills();
        try {
            areas = await Http.GetFromJsonAsync<List<AreaDto>>("/areas");
        } catch (Exception ex) {
            formError = $"Aviso: n\u00e3o foi poss\u00edvel carregar as \u00e1reas: {ex.Message}";
        }
    }

    private async Task LoadSkills()
    {
        skills = await SkillService.GetAllSkillsAsync();
    }

    private void OpenCreateModal()
    {
        formError = null;
        isEditMode = false;
        createSkill = new CreateSkillDto();
        showModal = true;
    }

    private Task OpenEditModal(SkillDto skill)
    {
        formError = null;
        isEditMode = true;
        editingSkillId = skill.Id;

        updateSkill = new UpdateSkillDto
        {
            Nome = skill.Nome,
            AreaId = skill.AreaId
        };

        showModal = true;
        return Task.CompletedTask;
    }

    private async Task HandleCreateSubmit()
    {
        try
        {
            isBusy = true;
            formError = null;

            var result = await SkillService.CreateSkillAsync(createSkill);
            if (result != null)
            {
                await LoadSkills();
                CloseModal();
                await JS.InvokeVoidAsync("alert", "Skill criada com sucesso!");
            }
            else
            {
                formError = "Não foi possível criar a skill.";
            }
        }
        catch (Exception ex)
        {
            formError = $"Erro ao criar skill: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleUpdateSubmit()
    {
        try
        {
            isBusy = true;
            formError = null;

            var success = await SkillService.UpdateSkillAsync(editingSkillId, updateSkill);
            if (success)
            {
                await LoadSkills();
                CloseModal();
                await JS.InvokeVoidAsync("alert", "Skill atualizada com sucesso!");
            }
            else
            {
                formError = "Não foi possível atualizar a skill (verifica se estás autenticada como Admin/UserManager).";
            }
        }
        catch (Exception ex)
        {
            formError = $"Erro ao atualizar skill: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ConfirmDelete(SkillDto skill)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Tem certeza que deseja apagar a skill '{skill.Nome}'?");
        if (confirmed)
        {
            await DeleteSkill(skill.Id);
        }
    }

    private async Task DeleteSkill(int id)
    {
        try
        {
            isBusy = true;

            var success = await SkillService.DeleteSkillAsync(id);
            if (success)
            {
                await LoadSkills();
                await JS.InvokeVoidAsync("alert", "Skill eliminada com sucesso!");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Erro ao apagar. Verifique se a Skill não está a ser utilizada num perfil e se é Admin.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro ao deletar: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void CloseModal()
    {
        showModal = false;
        formError = null;
        createSkill = new CreateSkillDto();
        updateSkill = new UpdateSkillDto();
        editingSkillId = 0;
        isEditMode = false;
    }
}