@page "/skills"
@using GestaoTalentos.Shared.DTOs
@using GestaoTalentos.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject ISkillService SkillService
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Skills - Gestão de Talentos</PageTitle>

<div class="page-header">
    <div>
        <h1>Catálogo de Skills</h1>
        <p class="page-subtitle">Gere as competências disponíveis na plataforma</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateModal" disabled="@isBusy">
        + Nova Skill
    </button>
</div>

@if (skills == null)
{
    <div class="loading-state">A carregar...</div>
}
else if (skills.Count == 0)
{
    <div class="empty-state">
        <div class="empty-ico">⚡</div>
        <h3>Ainda não há skills</h3>
        <p>Começa por adicionar a primeira competência ao catálogo.</p>
        <button class="btn btn-primary" @onclick="OpenCreateModal">Criar primeira skill</button>
    </div>
}
else
{
    <div class="card table-card">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Área</th>
                    <th>Criado em</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var skill in skills)
                {
                    <tr>
                        <td class="cell-name">@skill.Nome</td>
                        <td><span class="badge badge-area">@skill.AreaNome</span></td>
                        <td class="cell-muted">@skill.CriadoEm.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-secondary" @onclick="() => OpenEditModal(skill)" disabled="@isBusy">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(skill)" disabled="@isBusy">Apagar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseModal"></div>
    <div class="modal-custom" @onclick:stopPropagation>
        <div class="modal-head">
            <h3>@(isEditMode ? "Editar Skill" : "Nova Skill")</h3>
            <button class="modal-close" @onclick="CloseModal" disabled="@isBusy">×</button>
        </div>

        <div class="modal-body-custom">
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <div class="alert alert-danger">@formError</div>
            }

            @if (isEditMode)
            {
                <EditForm Model="@updateSkill" OnValidSubmit="@HandleUpdateSubmit">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Nome da Skill</label>
                        <InputText class="form-control" @bind-Value="updateSkill.Nome" placeholder="ex: React, C#, SQL" />
                        <ValidationMessage For="@(() => updateSkill.Nome)" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Área Profissional</label>
                        <InputSelect class="form-select" @bind-Value="updateSkill.AreaId">
                            <option value="0">Seleciona uma área</option>
                            @if (areas != null)
                            {
                                foreach (var area in areas)
                                {
                                    <option value="@area.Id">@area.Nome</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => updateSkill.AreaId)" />
                    </div>
                    <div class="modal-foot">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal" disabled="@isBusy">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@isBusy">@(isBusy ? "A guardar..." : "Guardar")</button>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="@createSkill" OnValidSubmit="@HandleCreateSubmit">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Nome da Skill</label>
                        <InputText class="form-control" @bind-Value="createSkill.Nome" placeholder="ex: React, C#, SQL" />
                        <ValidationMessage For="@(() => createSkill.Nome)" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Área Profissional</label>
                        <InputSelect class="form-select" @bind-Value="createSkill.AreaId">
                            <option value="0">Seleciona uma área</option>
                            @if (areas != null)
                            {
                                foreach (var area in areas)
                                {
                                    <option value="@area.Id">@area.Nome</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => createSkill.AreaId)" />
                    </div>
                    <div class="modal-foot">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal" disabled="@isBusy">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@isBusy">@(isBusy ? "A criar..." : "Criar Skill")</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 1.75rem;
        gap: 1rem;
    }

    .page-header h1 {
        margin-bottom: 0.25rem;
    }

    .page-subtitle {
        color: var(--color-text-muted);
        font-size: 0.92rem;
        margin: 0;
    }

    .table-card {
        padding: 0;
        overflow: hidden;
    }

    .cell-name {
        font-weight: 500;
    }

    .cell-muted {
        color: var(--color-text-muted);
        font-size: 0.88rem;
    }

    .badge-area {
        background: var(--color-primary-soft);
        color: var(--color-primary);
        font-weight: 500;
    }

    .loading-state {
        padding: 3rem;
        text-align: center;
        color: var(--color-text-muted);
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: var(--color-surface);
        border: 1px dashed var(--color-border-strong);
        border-radius: var(--radius-lg);
    }

    .empty-ico {
        font-size: 2.5rem;
        margin-bottom: 0.75rem;
    }

    .empty-state h3 {
        font-size: 1.1rem;
        margin-bottom: 0.35rem;
    }

    .empty-state p {
        color: var(--color-text-muted);
        margin-bottom: 1.25rem;
    }

    .modal-backdrop-custom {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        z-index: 1040;
        backdrop-filter: blur(2px);
    }

    .modal-custom {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 95%;
        max-width: 480px;
        background: var(--color-surface);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        z-index: 1050;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--color-border);
    }

    .modal-head h3 {
        margin: 0;
        font-size: 1.1rem;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        color: var(--color-text-muted);
        cursor: pointer;
        line-height: 1;
    }

    .modal-body-custom {
        padding: 1.5rem;
    }

    .modal-foot {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 1.5rem;
    }
</style>

@code {
    private List<SkillDto>? skills;
    private List<AreaDto>? areas;
    private CreateSkillDto createSkill = new();
    private UpdateSkillDto updateSkill = new();

    private bool showModal = false;
    private bool isEditMode = false;
    private int editingSkillId = 0;

    private bool isBusy = false;
    private string? formError = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadSkills();
        try {
            areas = await Http.GetFromJsonAsync<List<AreaDto>>("/areas");
        } catch (Exception ex) {
            formError = $"Aviso: não foi possível carregar as áreas: {ex.Message}";
        }
    }

    private async Task LoadSkills()
    {
        skills = await SkillService.GetAllSkillsAsync();
    }

    private void OpenCreateModal()
    {
        formError = null;
        isEditMode = false;
        createSkill = new CreateSkillDto();
        showModal = true;
    }

    private Task OpenEditModal(SkillDto skill)
    {
        formError = null;
        isEditMode = true;
        editingSkillId = skill.Id;

        updateSkill = new UpdateSkillDto
        {
            Nome = skill.Nome,
            AreaId = skill.AreaId
        };

        showModal = true;
        return Task.CompletedTask;
    }

    private async Task HandleCreateSubmit()
    {
        try
        {
            isBusy = true;
            formError = null;

            var result = await SkillService.CreateSkillAsync(createSkill);
            if (result != null)
            {
                await LoadSkills();
                CloseModal();
            }
            else
            {
                formError = "Não foi possível criar a skill.";
            }
        }
        catch (Exception ex)
        {
            formError = $"Erro ao criar skill: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleUpdateSubmit()
    {
        try
        {
            isBusy = true;
            formError = null;

            var success = await SkillService.UpdateSkillAsync(editingSkillId, updateSkill);
            if (success)
            {
                await LoadSkills();
                CloseModal();
            }
            else
            {
                formError = "Não foi possível atualizar a skill (verifica se tens permissões).";
            }
        }
        catch (Exception ex)
        {
            formError = $"Erro ao atualizar skill: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ConfirmDelete(SkillDto skill)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Queres mesmo apagar a skill '{skill.Nome}'?");
        if (confirmed)
        {
            await DeleteSkill(skill.Id);
        }
    }

    private async Task DeleteSkill(int id)
    {
        try
        {
            isBusy = true;
            var success = await SkillService.DeleteSkillAsync(id);
            if (success)
            {
                await LoadSkills();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Erro ao apagar. Verifica se a Skill não está a ser usada num perfil.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Erro: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void CloseModal()
    {
        showModal = false;
        formError = null;
        createSkill = new CreateSkillDto();
        updateSkill = new UpdateSkillDto();
        editingSkillId = 0;
        isEditMode = false;
    }
}
